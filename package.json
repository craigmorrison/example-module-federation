{
  "name": "example-module-federation",
  "version": "1.0.0",
  "private": true,
  "description": "Cross-bundler Module Federation proof of concept (Webpack, Rspack, Vite)",
  "license": "MIT",
  "author": "Craig Morrison",
  "repository": "https://github.com/craigmorrison/example-module-federation.git",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --filter=!portal-shell-ssr",
    "dev:ssr": "turbo run dev --filter=!portal-shell",
    "build": "turbo run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@module-federation/enhanced": "^2.9.3",
    "@module-federation/vite": "^1.24.0",
    "@playwright/test": "^1.65.1",
    "@rspack/cli": "^2.3.2",
    "@rspack/core": "^2.3.2",
    "@rspack/dev-server": "^2.2.2",
    "@swc/core": "^1.16.22",
    "@vitejs/plugin-react": "^6.3.0",
    "html-webpack-plugin": "^5.6.8",
    "jsdom": "^31.0.1",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "swc-loader": "^0.2.7",
    "turbo": "^2.11.11",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1",
    "webpack-dev-server": "^6.1.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "oxlint --fix",
    "*.{js,jsx,ts,tsx,css,md,json}": "oxfmt"
  },
  "packageManager": "npm@12.2.0"
}
