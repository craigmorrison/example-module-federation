{
  "name": "example-module-federation",
  "version": "1.0.0",
  "description": "Cross-bundler Module Federation proof of concept (Webpack, Rspack, Vite)",
  "repository": "https://github.com/craigmorrison/example-module-federation.git",
  "author": "Craig Morrison",
  "license": "MIT",
  "packageManager": "npm@12.2.0",
  "workspaces": [
    "packages/*"
  ],
  "private": true,
  "scripts": {
    "dev": "turbo run dev --filter=!portal-shell-ssr",
    "dev:ssr": "turbo run dev --filter=!portal-shell & turbo run dev --filter=portal-shell-ssr",
    "build": "turbo run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "turbo run lint",
    "format": "turbo run format"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "oxlint --fix",
    "*.{js,jsx,ts,tsx,css,md,json}": "oxfmt"
  },
  "overrides": {
    "defu": ">=6.1.5",
    "axios": ">=1.15.0",
    "uuid": ">=11.1.1",
    "ws": ">=8.21.0",
    "esbuild": ">=0.28.1",
    "adm-zip": "0.6.1",
    "undici@7": "7.29.1"
  },
  "devDependencies": {
    "@module-federation/enhanced": "^2.9.1",
    "@module-federation/vite": "^1.23.1",
    "@rspack/cli": "^2.2.7",
    "@rspack/core": "^2.2.7",
    "@swc/core": "^1.16.2",
    "@swc/plugin-emotion": "^16.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "html-webpack-plugin": "^5.6.8",
    "jsdom": "^30.1.2",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.85.0",
    "react-router": "^8.4.0",
    "swc-loader": "^0.2.7",
    "turbo": "^2.11.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0"
  }
}
